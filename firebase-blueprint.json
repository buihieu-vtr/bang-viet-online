{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Publicly readable non-PII user display metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown in the studio header",
          "minLength": 1,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Private user PII and personal custom color swatches.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address",
          "maxLength": 254
        },
        "customColors": {
          "type": "array",
          "description": "Saved custom hex color swatches (up to 24)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "updatedAt"]
    },
    "NotebookMeta": {
      "title": "NotebookMeta",
      "description": "Metadata for an isolated user notebook document.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Notebook document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Notebook title",
          "minLength": 1,
          "maxLength": 120
        },
        "slug": {
          "type": "string",
          "description": "Optional URL slug label",
          "maxLength": 80
        },
        "activePageId": {
          "type": "string",
          "description": "Currently selected page ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pageCount": {
          "type": "integer",
          "description": "Number of pages in this notebook"
        },
        "version": {
          "type": "integer",
          "description": "Schema version"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["id", "ownerId", "title", "activePageId", "pageCount", "version", "createdAt", "updatedAt"]
    },
    "NotebookPage": {
      "title": "NotebookPage",
      "description": "Single whiteboard/A4 page inside a user notebook.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Page ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "notebookId": {
          "type": "string",
          "description": "Parent notebook ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "order": {
          "type": "integer",
          "description": "Zero-based page order"
        },
        "title": {
          "type": "string",
          "description": "Page label",
          "minLength": 1,
          "maxLength": 80
        },
        "template": {
          "type": "string",
          "description": "Paper or board template",
          "enum": ["blank", "ivory", "greenboard", "greenboard_grid", "chalkboard", "ruled", "grid", "dots", "music"]
        },
        "pageSize": {
          "type": "string",
          "description": "Page dimensions preset",
          "enum": ["infinite", "slide16x9", "a4Portrait", "a4Landscape"]
        },
        "gridSize": {
          "type": "integer",
          "description": "Grid spacing in pixels"
        },
        "elements": {
          "type": "array",
          "description": "Native list of board elements (up to 2500 elements per page)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["id", "ownerId", "notebookId", "order", "title", "template", "pageSize", "gridSize", "elements", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/public/{docId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "User public profile subcollection (isolated non-PII display info)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "User private info subcollection (email and custom color palette)."
    },
    "/users/{userId}/notebooks/{notebookId}": {
      "schema": { "$ref": "#/entities/NotebookMeta" },
      "description": "Notebooks owned exclusively by userId."
    },
    "/users/{userId}/notebooks/{notebookId}/pages/{pageId}": {
      "schema": { "$ref": "#/entities/NotebookPage" },
      "description": "Pages belonging to a user's notebook."
    }
  }
}
